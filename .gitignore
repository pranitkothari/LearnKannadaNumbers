# Gradle wrapper distribution cache (jar itself is fine to commit if present)
gradle-wrapper.jar.tmp

# The Whisper-tiny (multilingual) model weights are the one offline asset not
# committed - they're hosted on HuggingFace, which this sandboxed dev
# environment couldn't reach. Everything else (espeak-ng data/libs,
# sherpa-onnx native libs) is committed. See README.md.
/app/src/main/assets/sherpa-onnx-whisper-tiny/*.onnx
/app/src/main/assets/sherpa-onnx-whisper-tiny/*.txt
